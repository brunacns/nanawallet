# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Painel do Supabase -> Project Settings -> API).
#
# SUPABASE_URL: URL pública do projeto (não é segredo).
# SUPABASE_PUBLISHABLE_KEY: chave publicável/anon (protegida por RLS, pode
#   ficar no frontend). NUNCA coloque aqui a "service_role key" — essa chave
#   ignora RLS e nunca deve existir neste projeto, em nenhum arquivo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
